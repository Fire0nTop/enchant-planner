{
	"schemaVersion": 1,
	"id": "enchant_planner",
	"version": "${version}",
	"name": "Enchant Planner",
	"description": "Shows the cheapest order to combine enchantment books right next to the anvil. Client-side only.",
	"authors": ["Fire"],
	"contributors": ["Algorithm ported from iamcal/enchant-order (MIT)"],
	"contact": {
		"homepage": "https://github.com/Fire0nTop/enchant-planner",
		"sources": "https://github.com/Fire0nTop/enchant-planner",
		"issues": "https://github.com/Fire0nTop/enchant-planner/issues"
	},
	"license": "MIT",
	"icon": "assets/enchant_planner/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.enchantplanner.EnchantPlannerClient"],
		"modmenu": ["com.enchantplanner.ModMenuIntegration"]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft_dependency}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
